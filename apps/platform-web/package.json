{
  "name": "@expadio/platform-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/migrate.mjs && node scripts/seed.cjs && node scripts/verify-runtime-schema.mjs && node scripts/start-standalone.mjs",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:integration": "node --experimental-strip-types --import ./test-integration/register.mjs --test test-integration/*.itest.ts",
    "seed:demo": "node --experimental-strip-types --import ./test-integration/register.mjs scripts/seed-demo.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.8.2",
    "@expadio/communication": "workspace:*",
    "@expadio/dentex": "workspace:*",
    "@expadio/iam": "workspace:*",
    "@expadio/postgres-runtime": "workspace:*",
    "@expadio/tenancy": "workspace:*",
    "@expadio/ui": "workspace:*",
    "next": "16.3.3",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "@expadio/credential-custody": "workspace:*",
    "@expadio/party": "workspace:*",
    "@expadio/lead": "workspace:*",
    "@expadio/case": "workspace:*",
    "@expadio/agreement": "workspace:*",
    "@expadio/business-config": "workspace:*",
    "@expadio/industry-packs": "workspace:*",
    "@expadio/governed-actions": "workspace:*",
    "@expadio/workflow": "workspace:*",
    "@expadio/learning": "workspace:*",
    "@expadio/ai-gateway": "workspace:*",
    "@expadio/provider-registry": "workspace:*",
    "@expadio/storage": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.8.3"
  }
}
